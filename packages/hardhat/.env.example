# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn generate or yarn account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=


# Optional Checkout constructor overrides.
# HBAR_USD_FEED defaults to the Chainlink HBAR/USD feed for the target network.
HBAR_USD_FEED=
# Reject prices older than this many seconds (default 3600).
MAX_PRICE_AGE_SEC=
