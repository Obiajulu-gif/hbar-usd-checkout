NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Hedera testnet account that writes receipts to HCS (server-side only, never NEXT_PUBLIC_).
# Get one at https://portal.hedera.com. Key may be DER (302...) or hex ECDSA.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Receipt topic, created with `yarn hcs:create-topic`.
NEXT_PUBLIC_HCS_TOPIC_ID=
# Optional, defaults to the public testnet mirror node.
NEXT_PUBLIC_MIRROR_NODE_URL=
